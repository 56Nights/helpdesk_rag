# Copy to .env and fill in. The app also reads plain environment variables.

# Groq key from https://console.groq.com  (without it the app still runs and
# shows recorded fixes, but writes no generated answer)
GROQ_API_KEY=gsk_your_key_here

# Leave blank to auto-detect a model the account can serve. Groq retires model
# IDs regularly, so pinning one is what breaks first.
GROQ_MODEL=

# Ticket export. Leave blank to try Kaggle, then fall back to the bundled sample.
DATA_CSV=

# hybrid | embedding | tfidf
RETRIEVER=hybrid
TOP_K=4
MIN_SCORE=0.12
MIN_MARGIN=0.05
